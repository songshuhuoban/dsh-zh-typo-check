{
  "name": "dsh-zh-typo-check",
  "version": "0.3.0",
  "description": "DSH 本地中文错字、标点与中英文混排整句异常检查。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "chinese",
    "cjk",
    "typo",
    "spellcheck",
    "proofreading"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songshuhuoban/dsh-zh-typo-check.git"
  },
  "homepage": "https://github.com/songshuhuoban/dsh-zh-typo-check#readme",
  "bugs": {
    "url": "https://github.com/songshuhuoban/dsh-zh-typo-check/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core.mjs",
    "tokenizer.mjs",
    "infer.mjs",
    "lexicon.mjs",
    "l1.mjs",
    "checker.mjs",
    "semantic-tokenizer.mjs",
    "semantic.mjs",
    "semantic-service.mjs",
    "data/*.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "MODEL-R13.md",
    "README.md"
  ],
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
