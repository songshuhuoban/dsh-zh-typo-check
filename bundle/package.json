{
  "name": "dsh-zh-typo-check",
  "version": "0.1.3",
  "description": "中文错别字与半角标点检查，用于 DSH 输入框。规则即时生效，语义错由可下载的本地模型补上。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "chinese",
    "cjk",
    "typo",
    "spellcheck",
    "proofreading"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songshuhuoban/dsh-zh-typo-check.git"
  },
  "homepage": "https://github.com/songshuhuoban/dsh-zh-typo-check#readme",
  "bugs": {
    "url": "https://github.com/songshuhuoban/dsh-zh-typo-check/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core.mjs",
    "tokenizer.mjs",
    "infer.mjs",
    "lexicon.mjs",
    "l1.mjs",
    "checker.mjs",
    "data/*.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
